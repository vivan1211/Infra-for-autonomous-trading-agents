# =============================================================================
# Prediction Market Agents — Environment Variables
# =============================================================================
# Copy the relevant sections into each service's environment.
#   - Frontend (Vercel):        the NEXT_PUBLIC_* + BACKEND_URL block
#   - Backend API (Railway):    the "Backend API" block
#   - Queue Worker (Railway):   the "Queue Worker" block
#   - Wiki Worker / Twitter:    the "Scheduled Workers" block
#
# NEVER commit real values. In production, inject secrets via your platform's
# secret store (Railway/Vercel env vars, or Doppler). See SECURITY.md.
# Exchange API keys and LLM keys are normally entered per-user in the app UI
# (encrypted at rest with MASTER_KEY) — the values below are for reference and
# for single-tenant / local development only.
# =============================================================================


# -----------------------------------------------------------------------------
# Frontend (Next.js — deploy on Vercel)  →  .env.local
# -----------------------------------------------------------------------------
# Base URL of the backend API (FastAPI service).
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket URL for live trade/telemetry updates (usually same host as the API).
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Supabase project URL + anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: server-side rewrite target for /api/* (defaults to NEXT_PUBLIC_API_URL).
BACKEND_URL=http://localhost:8000
# Optional: Sentry error tracking for the frontend.
NEXT_PUBLIC_SENTRY_DSN=
# Optional (SEO): IndexNow key file served at /indexnow-key.
INDEXNOW_KEY=


# -----------------------------------------------------------------------------
# Backend API (FastAPI — deploy on Railway)      [REQUIRED]
# -----------------------------------------------------------------------------
# Supabase Postgres connection string (use the pooler host, port 6543).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# AES-256 master key used to encrypt stored exchange/LLM credentials.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ chars. NEVER reuse the placeholder default in production.
MASTER_KEY=change-me-generate-a-32+char-random-key

# Supabase Auth — verify user JWTs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
# Service-role key: lets the backend bypass RLS for system operations. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS: the frontend origin allowed to call this API.
FRONTEND_URL=http://localhost:3000

# Kalshi environment: "demo" (paper) or "production" (real money).
KALSHI_ENVIRONMENT=demo

# Optional: Sentry error tracking for the backend.
SENTRY_DSN=

# Optional: Polymarket order retry budget in seconds (default 900 = 15 min).
POLY_ORDER_RETRY_BUDGET_S=900

# ---- LOCAL DEV ONLY — must be UNSET in production (the app hard-exits if set in prod) ----
# ALLOW_DEV_AUTH=1        # accept a dev user without a real Supabase JWT
# ALLOW_DEFAULT_KEY=1     # allow the placeholder MASTER_KEY (no real credentials!)

# ---- Only during MASTER_KEY rotation ----
# OLD_MASTER_KEY=previous-master-key


# -----------------------------------------------------------------------------
# Queue Worker (arq — deploy on Railway)         [REQUIRED for live bot cycles]
# -----------------------------------------------------------------------------
# Redis connection string for the arq job queue.
REDIS_URL=redis://localhost:6379
# Backend API base URL the worker calls for job config, logs, and results.
AGENT_FUND_BACKEND_URL=http://localhost:8000
# Same host used by bots to POST intercepted orders (usually = backend URL).
AGENT_FUND_INTERCEPT_URL=http://localhost:8000
# Shared secret authenticating worker→backend calls (X-Worker-Token). 32+ chars.
WORKER_SHARED_SECRET=change-me-32+char-shared-secret
# Same MASTER_KEY as the backend (worker decrypts credentials into a temp file).
# MASTER_KEY=...   # (see Backend API block)
# DATABASE_URL=... # (see Backend API block)


# -----------------------------------------------------------------------------
# Scheduled Workers — Wiki pipeline & Twitter/X poster (optional, on Railway)
# -----------------------------------------------------------------------------
# DATABASE_URL and MASTER_KEY as above.
# OpenRouter key used by the Twitter poster to generate post threads.
# OPENROUTER_API_KEY=sk-or-v1-...
# Twitter/X OAuth 2.0 (only if you enable the poster).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=
# Optional (SEO): Google Indexing API service-account JSON (single line) + IndexNow.
GOOGLE_INDEXING_SA_JSON=
# INDEXNOW_KEY=            # (same value as the frontend INDEXNOW_KEY)
PUBLIC_SITE_URL=https://www.example.com


# -----------------------------------------------------------------------------
# Exchange & LLM credentials
# Normally set PER-USER in the app UI (stored AES-256-GCM encrypted at rest).
# Listed here for single-tenant / local development and for reference.
# -----------------------------------------------------------------------------
# LLM provider for Council V2 / Superforecaster analysis + Perplexity research.
OPENROUTER_API_KEY=
# Optional OpenAI direct (used by some code paths / tools).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
# Superforecaster single-model selection (OpenRouter model id).
SUPERFORECASTER_MODEL=anthropic/claude-opus-4.6

# Polymarket (EVM wallet that signs CLOB orders).
POLYMARKET_PRIVATE_KEY=            # 64 hex chars (0x-prefixed 66 also accepted)
POLYMARKET_FUNDER_ADDRESS=         # funding/proxy (Safe) address, 40 hex chars
POLYMARKET_SIG_TYPE=2              # 2 = Gnosis Safe / browser wallet (default)

# Kalshi (API key id + RSA private key for request signing).
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=                # full PEM (with BEGIN/END lines); \n allowed
# KALSHI_PRIVATE_KEY_PATH=         # alternative: path to a .pem file


# -----------------------------------------------------------------------------
# Per-strategy bot tuning (optional — sensible defaults live in each bot's config.py)
# -----------------------------------------------------------------------------
# DAILY_AI_BUDGET=300              # USD/cycle AI spend cap (Council V2). Superforecaster ~10.
# MAX_MARKETS_PER_CYCLE=10
# MAX_POSITIONS=5
# MAX_POSITION_PCT=0.10
# KELLY_MULTIPLIER=0.25
# MIN_VOLUME_OVERRIDE=50
# MAX_EXPIRY_DAYS=7
# REANALYZE_COOLDOWN_HOURS=6
# EXCLUDED_CATEGORIES=Sports,Crypto
# MIN_CONTRACT_PRICE=0.40          # (tail-buyer uses its own 0.005–0.03 band)
# TRADE_SIZE=                      # per-order sizing for mechanical strategies
