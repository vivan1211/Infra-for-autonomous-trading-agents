NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Search engine indexing (optional; Phase 0 fix + Google Indexing API + IndexNow)
# -----------------------------------------------------------------------------
# Frontend (Vercel env): serves the IndexNow key-verification file at /indexnow-key.
INDEXNOW_KEY=

# Backend (Railway env): same IndexNow key as above. Backend posts to IndexNow
# using this key and references the frontend key-verification URL.
# INDEXNOW_KEY=<same-value-as-above>

# Backend (Railway env): Google Indexing API service account JSON (single line).
# Generate in Google Cloud Console, give the SA Owner access to the Search Console
# property for the site, then paste the full JSON here. Leave empty to disable.
GOOGLE_INDEXING_SA_JSON=

# Backend (Railway env): base URL for building canonical trade page URLs.
# Defaults to https://www.example.com if unset.
PUBLIC_SITE_URL=https://www.example.com
